--[[
    The closed set of globals this add-on owns: its SavedVariables table, its
    slash registrations, and its key-binding header (the BINDING_NAME_ strings
    are written through _G, so they need no entry).
]]
globals = {
	"TFTBDB",
	"SLASH_TFTB1",
	-- The Buff Keys' heading in the game's Key Bindings list.
	"BINDING_HEADER_TFTB",
	-- A field, so only the add-on's own slash entries are writable.
	SlashCmdList = {
		fields = { "TFTB", "TFTB_THANKYOU1", "TFTB_THANKYOU2", "TFTB_THANKYOU3", "TFTB_THANKYOU4", "TFTB_THANKYOU5" },
	},
}
