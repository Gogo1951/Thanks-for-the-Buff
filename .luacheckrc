--[[
    The closed set of globals this add-on owns: its SavedVariables table and
    its slash registrations (the /thankyou commands' SLASH_ strings are written
    through _G, so they need no entry).
]]
globals = {
	"TFTBDB",
	"SLASH_TFTB1",
	-- A field, so only the add-on's own slash entries are writable.
	SlashCmdList = {
		fields = { "TFTB", "TFTB_THANKYOU1", "TFTB_THANKYOU2", "TFTB_THANKYOU3", "TFTB_THANKYOU4", "TFTB_THANKYOU5" },
	},
}
