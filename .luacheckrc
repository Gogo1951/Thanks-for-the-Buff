std = "lua51"
max_line_length = false -- StyLua owns formatting
ignore = { "212/self", "611", "612", "613", "614", "621" } -- implicit self (house ns: methods) + whitespace
exclude_files = { "Includes/", ".claude/" } -- vendored or session-local, never linted

